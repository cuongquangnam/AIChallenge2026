# Storage / infra
DATA_DIR=./data
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200

# Collections / indices
QDRANT_COLLECTION=video_keyframes
ES_INDEX=video_text

# Encoder dimensions (must match model outputs)
SIGLIP_DIM=768
BEIT3_DIM=768

# Model backends: "mock" (no GPU / no weights) or "real"
VISUAL_BACKEND=real
OCR_BACKEND=mock
ASR_BACKEND=mock
SHOT_BACKEND=opencv

# Optional real backends
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free tier also has per-model DAILY caps (e.g. gemini-3.5-flash ≈ 20 req/day).
GEMINI_RPM=5
GEMINI_MAX_RETRIES=5
GEMINI_BATCH_SIZE=10
WHISPER_MODEL=base
SIGLIP_MODEL_ID=google/siglip-base-patch16-224
BEIT3_MODEL_ID=microsoft/beit-base-patch16-224

# Multimodal Q&A (configure later when an API key is available)
# Backend must expose an OpenAI-compatible /chat/completions endpoint with image inputs.
QA_LLM_BACKEND=none
QA_LLM_API_KEY=
QA_LLM_BASE_URL=https://api.openai.com/v1
QA_LLM_MODEL=
QA_LLM_TIMEOUT_SEC=120
QA_RETRIEVAL_LIMIT=50
QA_GROUP_COUNT=10
QA_FRAME_RADIUS=5
QA_FRAME_STRIDE=1
QA_MIN_CENTER_GAP=10

# API
API_HOST=0.0.0.0
API_PORT=8000
