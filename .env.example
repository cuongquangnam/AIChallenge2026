# Storage / infra
# Local output root (videos/, keyframes/, audio/, manifests/). Override with --data-dir.
DATA_DIR=./data
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200

# Collections / indices
QDRANT_COLLECTION=video_keyframes
ES_INDEX=video_text

# Encoder dimensions (must match model outputs)
SIGLIP_DIM=768

# Model backends: "mock" (no GPU / no weights) or "real"
# Fully local Mac stack: VISUAL_BACKEND=real, OCR_BACKEND=rapidocr, ASR_BACKEND=whisper, QUERY_PLANNER=heuristic
VISUAL_BACKEND=real
OCR_BACKEND=rapidocr
ASR_BACKEND=whisper
SHOT_BACKEND=opencv
OCR_WORKERS=4

# Optional Gemini OCR/planner (not required on Mac)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Cheap OCR alternative: gemini-3.1-flash-lite (gemini-2.5-flash-lite is 404 for new keys).
# Free tier also has per-model DAILY caps (e.g. gemini-3.5-flash ≈ 20 req/day).
GEMINI_RPM=5
GEMINI_MAX_RETRIES=5
GEMINI_BATCH_SIZE=10
QUERY_PLANNER=heuristic
WHISPER_MODEL=base
SIGLIP_MODEL_ID=google/siglip-base-patch16-224

# API
API_HOST=0.0.0.0
API_PORT=8000
