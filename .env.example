# Storage / infra
# Local output root (videos/, keyframes/, audio/, manifests/). Override with --data-dir.
DATA_DIR=./data
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200

# Collections / indices
QDRANT_COLLECTION=video_keyframes
ES_INDEX=video_text
# TransNet exports on Drive use:
# QDRANT_COLLECTION=video_keyframes_transnet
# ES_INDEX=video_text_transnet

# Encoder dimensions (must match model outputs)
SIGLIP_DIM=768
BEIT3_DIM=768

# Model backends: "mock" (no GPU / no weights) or "real"
VISUAL_BACKEND=real
OCR_BACKEND=mock
ASR_BACKEND=mock
SHOT_BACKEND=opencv

# Optional real backends
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Cheap OCR alternative: gemini-3.1-flash-lite (gemini-2.5-flash-lite is 404 for new keys).
# Free tier also has per-model DAILY caps (e.g. gemini-3.5-flash ≈ 20 req/day).
GEMINI_RPM=5
GEMINI_MAX_RETRIES=5
GEMINI_BATCH_SIZE=10
# Shared multimodal LLM for planner / KIS-QA-TRAKE event split / QA / optional OCR:
#   auto     — Gemini when GEMINI_API_KEY is set, else none/heuristic
#   gemini   — cloud Gemini
#   qwen_vl  — local Qwen2.5-VL (A100 80GB bf16 for 32B)
LLM_BACKEND=auto
QA_LLM_BACKEND=auto
QUERY_PLANNER=auto
# Local Qwen VL (Colab A100 80GB: bf16 32B; A100 40GB: QWEN_VL_DTYPE=4bit or use 8B)
# Latest: Qwen/Qwen3-VL-32B-Instruct | Qwen/Qwen3-VL-8B-Instruct | Qwen/Qwen2.5-VL-32B-Instruct
QWEN_VL_MODEL_ID=Qwen/Qwen3-VL-32B-Instruct
QWEN_VL_DTYPE=bf16
QWEN_VL_DEVICE=auto
QWEN_VL_MAX_NEW_TOKENS=2048
WHISPER_MODEL=base
SIGLIP_MODEL_ID=google/siglip-base-patch16-224
BEIT3_MODEL_ID=microsoft/beit-base-patch16-224

CHAIN_RERANK_ENABLED=true
CHAIN_RERANK_BACKEND=auto
CHAIN_RERANK_MODEL_ID=Salesforce/blip-itm-base-coco
CHAIN_RERANK_BLEND=0.6
MODEL_POOL_SIZE=3
CHAIN_GAP_WEIGHT=0.5
CHAIN_GAP_HARD_FACTOR=3.0
VIDEO_FPS=25

# API
API_HOST=0.0.0.0
API_PORT=8000

# --- Split architecture: laptop UI + Google Drive + Colab search ---
# Set REMOTE_COMPUTE=colab to run search / KIS / QA / TRAKE on Colab via google-colab-cli.
# Index artifacts are pulled once at Colab session start (elasticsearch/, qdrant/, manifests/).
# Keyframes/videos stay on Drive by default and are pulled/extracted only when needed.
REMOTE_COMPUTE=

# Google Drive (Colab mounts at DRIVE_MOUNT; laptop uses DRIVE_LOCAL_PATH for sync)
DRIVE_MOUNT=/content/drive
DRIVE_DATA_PATH=MyDrive/video-retrieval
DRIVE_LOCAL_PATH=

COLAB_SESSION=video-retrieval
COLAB_CLI=colab
COLAB_GPU=T4
COLAB_HIGH_MEM=false
COLAB_TIMEOUT_SEC=600
COLAB_REMOTE_DATA_DIR=/content/data
COLAB_ELASTICSEARCH_INSTALL_DIR=/content/elasticsearch
COLAB_QDRANT_INSTALL_DIR=/content/qdrant
# false = you start Colab and run scripts/colab/MANUAL_SETUP.md (recommended)
COLAB_AUTO_MANAGE=false
# Prefer long-running worker on the VM (auto|persistent|oneshot)
COLAB_WORKER_MODE=auto
COLAB_WORKER_PORT=8765
# Cloudflare tunnel (notebook cell 5b). When set, laptop talks to worker over HTTPS
# via async submit+poll (/jobs) so long QA jobs are not cut by Cloudflare's ~100s limit.
# COLAB_WORKER_PUBLIC_URL=https://xxxx.trycloudflare.com
# COLAB_WORKER_MODE=tunnel
# COLAB_JOB_POLL_INTERVAL_SEC=2
# Colab git clone + VM env upload (see scripts/colab/MANUAL_SETUP.md):
COLAB_REPO_URL=https://github.com/you/AIChallenge2026_2.git
COLAB_REPO_BRANCH=cuong/use-colab
